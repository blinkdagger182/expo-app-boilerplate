# =====================================================================
# ENVIRONMENT CONFIGURATION
# =====================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# =====================================================================

# =====================================================================
# SUPABASE CONFIGURATION
# =====================================================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# =====================================================================
# SUPERWALL CONFIGURATION
# =====================================================================
# Get these from: https://superwall.com/dashboard (iOS + Android sections)
EXPO_PUBLIC_SUPERWALL_API_KEY_IOS=your_ios_api_key_here
EXPO_PUBLIC_SUPERWALL_API_KEY_ANDROID=your_android_api_key_here

# =====================================================================
# GEMINI AI CONFIGURATION
# =====================================================================
# Get this from: https://makersuite.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# =====================================================================
# GCP OCR CONFIGURATION
# =====================================================================
# Your GCP Cloud Run PaddleOCR service URL
EXPO_PUBLIC_GCP_OCR_URL=https://paddleocr-ui-builder-824241800977.us-central1.run.app
